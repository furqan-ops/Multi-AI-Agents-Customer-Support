# ==========================================
# Multi-Agent Customer Support System - ENV Template
# ==========================================

# OpenRouter / LLM
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SECRET_KEY=your_supabase_service_role_key_here

# Speech & Voice (Deepgram)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# n8n Orchestrator Webhook
SUPERVISOR_URL=http://localhost:5678/webhook/supervisor

# Backend URL for Frontend
NEXT_PUBLIC_FLASK_URL=http://localhost:5000