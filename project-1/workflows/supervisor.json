    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst msg = (item.message || \"\").toLowerCase().trim();\n\nlet intent = \"faq\";\n\nif (/^(hello|hi|hey|good morning|good afternoon|good evening|howdy)\\b/.test(msg) || [\"hello\", \"hi\", \"hey\"].includes(msg)) {\n  intent = \"greeting\";\n} else if (/(did|is|has).*(order|booking|reservation).*(book|confirm|place|go through|succeed)|(check|track|view|status of).*(order|booking|reservation)/.test(msg)) {\n  intent = \"booking_status\";\n} else if (/book|reserve|table|reservation/.test(msg)) {\n  intent = \"booking\";\n} else if (/complaint|angry|terrible|worst|unacceptable|sue|lawyer/.test(msg)) {\n  intent = \"complaint\";\n} else if (/fire|emergency|urgent|help now/.test(msg)) {\n  intent = \"emergency\";\n}\n\nreturn [{\n  json: {\n    ...item,\n    intent: intent\n  }\n}];"
      },
