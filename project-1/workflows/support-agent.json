      "typeVersion": 4.2,
      "position": [
        -1360,
        704
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst embedding = item.json.data[0].embedding;\n\nreturn [{\n  json: {\n    query_embedding: JSON.stringify(embedding),\n    message: item.json.message || $('Normalize Input').first().json.message,\n  }\n}];"
      },
      "id": "e0168adb-d80c-4c39-a36a-9e31071e5e6c",
      "name": "Format Query Vector",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1136,
        704
      ]
    },
    {
      "parameters": {
        "jsCode": "const chunks = $input.all().map(i => i.json);\nconst context = chunks.map(c => c.content).join(\"\\n\\n---\\n\\n\");\nconst sources = [...new Set(chunks.map(c => c.source))];\nconst topSimilarity = chunks[0]?.similarity || 0;\n\nreturn [{\n  json: {\n    context: context,\n    sources: sources,\n    top_similarity: topSimilarity,\n  }\n}];"
      },
      "id": "4345a107-282b-4e06-876e-8d3137d23ec3",
      "name": "Build Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -688,
        704
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Context:\n{{ $json.context }}\n\nQuestion: {{ $('Normalize Input').item.json.message }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a Support Agent. You must respond with ONLY a valid JSON object.  Use ONLY the provided context. Do not add reasoning, do not add explanations, do not use <think> tags.  Format: {\"answer\": \"your answer text\", \"confidence\": 0.9}  If the answer is not in the context: {\"answer\": null, \"confidence\": 0}  Nothing else. No markdown. No code fences."
            }
          ]
        }
      },
      "id": "265907ac-6073-4386-a34b-ccb17d923a1d",
      "name": "Generate Answer",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.6,
      "position": [
        -544,
        704
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "meta-llama/llama-3.1-8b-instruct",
          "mode": "list",
          "cachedResultName": "meta-llama/llama-3.1-8b-instruct"
        },
        "options": {}
