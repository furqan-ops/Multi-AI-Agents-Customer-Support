      "id": "74891b08-42f1-4d25-a029-815e23697bd6",
      "name": "OpenRouter Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        -480,
        896
      ],
      "credentials": {
        "openAiApi": {
          "id": "h32tgRZPBI5Wqx9S",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  let raw = item.json.text || item.json.response || \"\";\n\n  // Strip <think>...</think> blocks\n  raw = raw.replace(/<think>[\\s\\S]*?<\\/think>/g, \"\").trim();\n\n  // Strip markdown code fences\n  raw = raw.replace(/```json|```/g, \"\").trim();\n\n  let parsed;\n  try {\n    parsed = JSON.parse(raw);\n  } catch (e) {\n    // Try to extract JSON from text\n    const match = raw.match(/\\{[\\s\\S]*\\}/);\n    if (match) {\n      try {\n        parsed = JSON.parse(match[0]);\n      } catch (e2) {\n        parsed = { answer: null, confidence: 0 };\n      }\n    } else {\n      parsed = { answer: null, confidence: 0 };\n    }\n  }\n\n  results.push({\n    json: {\n      answer: parsed.answer,\n      confidence: parsed.confidence,\n      sources: $('Build Context').first().json.sources,\n      top_similarity: $('Build Context').first().json.top_similarity,\n    }\n  });\n}\n\nreturn results;"
      },
