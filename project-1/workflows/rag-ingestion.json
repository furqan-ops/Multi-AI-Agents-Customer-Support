    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst text = item.json.text;\nconst source = \"faq.txt\";\nconst size = 500;\nconst chunks = [];\n\nfor (let i = 0; i < text.length; i += size) {\n  chunks.push({\n    json: {\n      content: text.slice(i, i + size).trim(),\n      chunk_index: chunks.length,\n      source: source,\n    }\n  });\n}\n\nreturn chunks;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
