    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst response = (item.response || \"\").toLowerCase();\nconst context = (item.context || \"\").toLowerCase();\n\n// Extract keywords from response (words > 4 chars)\nconst words = response.match(/\\b[a-z]{5,}\\b/g) || [];\nconst uniqueWords = [...new Set(words)];\n\n// Count how many response keywords appear in context\nlet found = 0;\nfor (const w of uniqueWords) {\n  if (context.includes(w)) found++;\n}\n\nconst coverage = uniqueWords.length > 0 ? found / uniqueWords.length : 0;\n\n// If less than 50% of response keywords appear in context, reject\nconst approved = coverage >= 0.5;\n\nreturn [{\n  json: {\n    ...item,\n    approved: approved,\n    reason: approved\n      ? `keyword coverage ${Math.round(coverage * 100)}%`\n      : `low keyword coverage ${Math.round(coverage * 100)}% - likely hallucination`,\n    skip_llm: approved\n  }\n}];"
      },
