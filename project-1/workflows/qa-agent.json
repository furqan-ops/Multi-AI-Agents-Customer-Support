    {
      "parameters": {
        "jsCode": "const results = [];\nconst preCheck = $('Keyword Check').first().json;\n\n// Debug: log what preCheck sees\nconsole.log('PRECHECK:', JSON.stringify(preCheck));\n\nconst llmItem = $input.first();\nlet raw = llmItem.json.text || llmItem.json.response || \"\";\nlet parsed;\n\ntry {\n  const cleaned = raw.replace(/```json|```/g, \"\").trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { approved: false, reason: \"invalid_json_from_qa\" };\n}\n\n// Strict boolean check\nconst preApproved = preCheck.approved === true;\nconst llmApproved = parsed.approved === true;\n\nconst approved = preApproved && llmApproved;\n\nlet reason;\nif (!preApproved) {\n  reason = \"keyword_check_failed: \" + (preCheck.reason || \"unknown\");\n} else if (!llmApproved) {\n  reason = \"llm_qa_failed: \" + (parsed.reason || \"unknown\");\n} else {\n  reason = \"both_passed\";\n}\n\nresults.push({\n  json: {\n    request_id: preCheck.request_id,\n    agent: preCheck.agent,\n    response: preCheck.response,\n    approved: approved,\n    reason: reason,\n    debug_preApproved: preApproved,\n    debug_llmApproved: llmApproved\n  }\n});\n\nreturn results;"
      },
      "id": "9bf018d4-2206-46bf-af2a-bdee720a4482",
      "name": "Parse QA",
