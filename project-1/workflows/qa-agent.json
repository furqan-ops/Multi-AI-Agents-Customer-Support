    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a strict fact-checker. You must reject any response that makes a claim NOT explicitly stated in the context.\n\nContext:\n{{ $json.context }}\n\nQuestion: {{ $json.user_message }}\n\nAgent response: {{ $json.response }}\n\nStep 1: List every factual claim in the agent response.\nStep 2: For each claim, check if it appears in the context.\nStep 3: If ANY claim is not in the context, approved = false.\nStep 4: If ALL claims appear in the context, approved = true.\n\nReturn ONLY this JSON:\n{\"approved\": true/false, \"reason\": \"...\"}"
      },
      "id": "c9989702-3a3e-4d39-9fe0-882af613e9b9",
      "name": "QA Review",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.6,
      "position": [
        -464,
        112
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "openrouter/free",
          "mode": "list",
          "cachedResultName": "openrouter/free"
        },
        "options": {}
      },
      "id": "d193f449-eec9-409d-975b-3858056b2c43",
      "name": "OpenRouter Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        -464,
        304
      ],
      "credentials": {
