    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nif (item.approved) {\n  return [{ json: { status: 'approved', response: item.response } }];\n}\n\nreturn [{\n  json: {\n    status: 'rejected',\n    reason: item.reason,\n    escalate_to: 'human',\n    request_id: item.request_id\n  }\n}];"
      },
