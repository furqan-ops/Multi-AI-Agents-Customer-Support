    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  let raw = item.json.text || item.json.response || \"\";\n  let parsed;\n\n  try {\n    const cleaned = raw.replace(/```json|```/g, \"\").trim();\n    parsed = JSON.parse(cleaned);\n  } catch (e) {\n    parsed = { intent: \"escalate\", confidence: 0 };\n  }\n\n  const validIntents = [\"booking\", \"faq\", \"complaint\", \"emergency\"];\n  if (!validIntents.includes(parsed.intent)) {\n    parsed = { intent: \"escalate\", confidence: 0 };\n  }\n\n  results.push({\n    json: {\n      ...item.json,\n      intent: parsed.intent,\n      confidence: parsed.confidence,\n    }\n  });\n}\n\nreturn results;"
      },
