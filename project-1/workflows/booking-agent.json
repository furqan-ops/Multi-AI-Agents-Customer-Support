    {
      "parameters": {
        "jsCode": "const item = $('Parse Booking').first().json;\nconst missing = item.missing || [];\n\nif (missing.includes('all') || missing.length >= 3) {\n  return [{\n    json: {\n      status: 'need_more_info',\n      request_id: item.request_id,\n      message: \"I'd be happy to help you book a table! Could you please let me know what date, time, and how many guests you would like to reserve for?\"\n    }\n  }];\n}\n\nconst questions = missing.map(f => {\n  if (f === 'date') return 'What date would you like?';\n  if (f === 'time') return 'What time?';\n  if (f === 'party_size') return 'How many people?';\n  return 'Could you please specify the ' + f + '?';\n});\n\nreturn [{\n  json: {\n    status: 'need_more_info',\n    request_id: item.request_id,\n    message: questions.join(' ')\n  }\n}];"
      },
