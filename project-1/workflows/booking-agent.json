    {
      "parameters": {
        "promptType": "define",
        "text": "=Extract booking details from this message: {{ $json.message }}\n\nToday is {{ $now.toISODate() }}.\n\nReturn ONLY valid JSON in this exact format:\n{\"date\": \"YYYY-MM-DD\", \"time\": \"HH:MM\", \"party_size\": <number>, \"missing\": []}\n\nIf any field is missing from the message, add its name to the missing array and use null for that field."
      },
      "id": "d03bd654-96c3-4609-b4a6-6a4e56bd1895",
      "name": "Extract Details",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
