    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  let raw = item.json.text || item.json.response || \"\";\n  let parsed;\n\n  try {\n    const cleaned = raw.replace(/```json|```/g, \"\").trim();\n    parsed = JSON.parse(cleaned);\n  } catch (e) {\n    parsed = { date: null, time: null, party_size: null, missing: [\"all\"] };\n  }\n\n  results.push({\n    json: {\n      request_id: $('Normalize Input').first().json.request_id,\n      user_id: $('Normalize Input').first().json.user_id,\n      channel: $('Normalize Input').first().json.channel,\n      message: $('Normalize Input').first().json.message,\n      date: parsed.date,\n      time: parsed.time,\n      party_size: parsed.party_size,\n      missing: parsed.missing || []\n    }\n  });\n}\n\nreturn results;"
      },
